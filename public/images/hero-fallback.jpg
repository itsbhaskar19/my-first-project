<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="heroGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1b4332;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#2d5a4a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#40916c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#heroGradient)"/>
  <text x="960" y="500" font-family="Arial, sans-serif" font-size="72" fill="white" text-anchor="middle">🌱 Lakshmi Shanmukhi Nursery Gardens</text>
  <text x="960" y="600" font-family="Arial, sans-serif" font-size="36" fill="#d8f3dc" text-anchor="middle">Premium Plants & Gardening Excellence</text>
</svg>
